{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": false,
    "types": ["node"]
  },
  "include": ["src", "test", "tsdown.config.ts"]
}
