# Local Chopsticks fork (no secrets: //Alice is a public dev key).
# pUSD and its pool are created by `pnpm setup:fork` (or `pnpm spike:fee`).
STABLETAP_WS=ws://localhost:8000
STABLETAP_ASSET_ID=7778
STABLETAP_ASSET_DECIMALS=6

ISSUER_SURI=//Alice
SETUP_ASSET_NAME=Portaldot USD (test)
SETUP_ASSET_SYMBOL=pUSD
SETUP_MIN_BALANCE=0.01
SETUP_MINT=100000
SETUP_POOL_NATIVE=150
SETUP_POOL_STABLE=150
# Second token (PORT) for pay-with-any-token, created by `pnpm setup:fork:port`.
STABLETAP_PORT_ASSET_ID=7781
