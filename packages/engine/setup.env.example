# Copy to .env.setup (git-ignored) and fill in. Used by `pnpm setup:stablecoin`.
STABLETAP_WS=wss://test-node-v3.portaldot.dev
STABLETAP_ASSET_ID=7777
STABLETAP_ASSET_DECIMALS=6

# Secret: mnemonic of the issuer account (pays deposits, owns the asset, provides liquidity).
ISSUER_SURI=

SETUP_ASSET_NAME=Portaldot USD (test)
SETUP_ASSET_SYMBOL=pUSD
# Human units.
SETUP_MIN_BALANCE=0.01
SETUP_MINT=100000
# Pool ratio sets the fee price: 150 tPOT : 150 pUSD = 1 pUSD per tPOT.
SETUP_POOL_NATIVE=150
SETUP_POOL_STABLE=150
