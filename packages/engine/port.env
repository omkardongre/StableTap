# Plan for PORT, a test community token used to show "pay with any token".
# Layered over the network env (secret stays in .env.setup / test/fork.env).
STABLETAP_ASSET_ID=7780
STABLETAP_ASSET_DECIMALS=6
SETUP_ASSET_NAME=Portaldot Community (test)
SETUP_ASSET_SYMBOL=PORT
SETUP_MIN_BALANCE=0.01
SETUP_MINT=1000000
# 2 PORT per tPOT, so 1 PORT is about $0.50.
SETUP_POOL_NATIVE=100
SETUP_POOL_STABLE=200
