{
  "name": "@stabletap/indexer",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Indexes StableTap payments and refunds from finalized blocks, serves history and stats, delivers signed webhooks",
  "scripts": {
    "start": "node --env-file=.env src/main.ts",
    "start:fork": "node --env-file=fork.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@polkadot/api": "17.0.2",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@stabletap/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
