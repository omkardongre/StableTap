# Local Chopsticks fork (no secrets). Fork-only asset 7778, see packages/engine/test/fork.env.
STABLETAP_WS=ws://localhost:8000
STABLETAP_ASSET_ID=7778
STABLETAP_ASSET_DECIMALS=6
# Chopsticks cannot serve blocks from before the fork point, so start at the fork head.
INDEXER_START_BLOCK=head
INDEXER_DB=./data/fork.db
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8787
INDEXER_CORS_ORIGINS=http://localhost:3000
# Dev only: lets a local test receiver get webhooks over http.
INDEXER_ALLOW_INSECURE_WEBHOOKS=1
