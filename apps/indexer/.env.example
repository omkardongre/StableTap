# Copy to .env (git-ignored). No secrets here: the indexer only reads the chain.
STABLETAP_WS=wss://test-node-v3.portaldot.dev
STABLETAP_ASSET_ID=7777
STABLETAP_ASSET_DECIMALS=6
# Block the stablecoin was created in (see evidence/testnet-setup.json).
INDEXER_START_BLOCK=148225
INDEXER_DB=./data/indexer.db
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8787
# Web app origin(s) allowed to call the API, comma separated.
INDEXER_CORS_ORIGINS=http://localhost:3000
