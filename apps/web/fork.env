# Local Chopsticks fork only (no secrets: //Alice is a public dev key).
# Fork-only asset 7778, created by `pnpm --filter @stabletap/engine setup:fork`.
NEXT_PUBLIC_STABLETAP_WS=ws://localhost:8000
NEXT_PUBLIC_STABLETAP_ASSET_ID=7778
NEXT_PUBLIC_STABLETAP_ASSET_DECIMALS=6
FAUCET_SURI=//Alice
FAUCET_STABLE_AMOUNT=20
# Indexer (apps/indexer, `pnpm start:fork`) for dashboard, stats and webhooks.
NEXT_PUBLIC_STABLETAP_INDEXER=http://localhost:8787
# Platform share on every POS invoice: //Dave (public dev key), 1%.
NEXT_PUBLIC_STABLETAP_PLATFORM_ADDRESS=5DAAnrj7VHTznn2AWBemMuyBwZWs6FNFjdyVXUeYum3PTXFy
NEXT_PUBLIC_STABLETAP_PLATFORM_BPS=100
# Pay with any token: PORT (fork asset 7781, `pnpm --filter @stabletap/engine setup:fork:port`).
NEXT_PUBLIC_STABLETAP_PAY_ASSETS=7781
FAUCET_ALT_ASSET_ID=7781
FAUCET_ALT_AMOUNT=20
