# Public network settings (inlined into the browser bundle at build time).
NEXT_PUBLIC_STABLETAP_WS=wss://test-node-v3.portaldot.dev
NEXT_PUBLIC_STABLETAP_ASSET_ID=
NEXT_PUBLIC_STABLETAP_ASSET_DECIMALS=6

# Server only. Faucet that gives a new wallet the existential deposit plus test pUSD.
# Secret URI (mnemonic) of a funded account. Never commit a real one.
FAUCET_SURI=
# Test pUSD per new wallet, in dollars.
FAUCET_STABLE_AMOUNT=20
# Optional. Indexer API (apps/indexer) for the dashboard, stats page and webhooks.
NEXT_PUBLIC_STABLETAP_INDEXER=
# Optional. Block explorer; tx links become <explorer>/#/extrinsics/<block>-<index>.
NEXT_PUBLIC_STABLETAP_EXPLORER=https://scanner-testnet-v3.portaldot.dev
# Optional, set both or neither. Platform share split off every POS invoice (basis points, max 1000).
NEXT_PUBLIC_STABLETAP_PLATFORM_ADDRESS=
NEXT_PUBLIC_STABLETAP_PLATFORM_BPS=
# Optional. Other assets customers may pay with (comma-separated ids, each with a native pool).
NEXT_PUBLIC_STABLETAP_PAY_ASSETS=
# Optional, server only, set both or neither. Faucet alternative: hand out this asset instead of pUSD.
FAUCET_ALT_ASSET_ID=
FAUCET_ALT_AMOUNT=
# Optional, set all four or none. MetaMask checkout (/checkout) through the PotCheckout contract.
NEXT_PUBLIC_STABLETAP_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_STABLETAP_EVM_CHAIN_ID=420420777
NEXT_PUBLIC_STABLETAP_CHECKOUT_ADDRESS=
# Block the contract was deployed in (history is read from here).
NEXT_PUBLIC_STABLETAP_CHECKOUT_FROM_BLOCK=
# Optional. Chain name shown when the wallet adds the network.
NEXT_PUBLIC_STABLETAP_EVM_CHAIN_NAME=Portaldot V3 testnet
