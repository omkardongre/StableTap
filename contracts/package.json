{
  "name": "@stabletap/contracts",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "PotCheckout: invoice registry, replay guard, hold/capture and refunds for pUSD through Portaldot's ERC-20 asset precompile",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "hardhat build && tsc --noEmit",
    "live": "node --env-file=.env node_modules/hardhat/dist/src/cli.js run scripts/live.ts --network portaldotTestnet",
    "fork:check": "hardhat build && node --env-file=../packages/engine/test/fork.env scripts/fork-check.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.2",
    "@nomicfoundation/hardhat-viem": "3.1.0",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.5",
    "@openzeppelin/contracts": "5.6.1",
    "@polkadot/api": "17.0.2",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@stabletap/engine": "workspace:*",
    "@types/node": "24.19.2",
    "hardhat": "3.21.0",
    "typescript": "5.9.3",
    "viem": "2.57.10"
  }
}
